# /etc/truelabel/backend.env — chmod 0640, owned root:truelabel.

# Loopback, not 0.0.0.0. nginx is on the same host, so nothing else needs to
# reach this port — and with TRUSTED_PROXY_HOPS set, anyone who could reach
# it directly would be able to forge X-Forwarded-For and walk past every
# rate limit. This single line is what makes that impossible.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

APP_ENV=production
RUST_LOG=info

# nginx is the one proxy in front, and it appends the real client address to
# X-Forwarded-For. Without this the peer address is always nginx, so every
# user in the world shares one rate-limit bucket and the API starts returning
# 429 to everybody. Count only hops that append: add a CDN in front and this
# becomes 2.
TRUSTED_PROXY_HOPS=1

# Browser origins allowed to call the API. The iOS app sends no Origin, so
# leave this empty until the web app has a domain.
ALLOWED_ORIGINS=

DATABASE_URL=postgresql://truelabel:CHANGE_ME@127.0.0.1:5432/truelabel
REDIS_URL=redis://127.0.0.1:6379
MAX_DB_CONNECTIONS=10
MAX_REDIS_CONNECTIONS=10

APPLE_BUNDLE_ID=com.tarun.truelable
