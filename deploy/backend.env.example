# /etc/truelabel/backend.env — chmod 0640, owned root:truelabel.

# Loopback, not 0.0.0.0. nginx is on the same host, so nothing else needs to
# reach this port — and with TRUSTED_PROXY_HOPS set, anyone who could reach
# it directly would be able to forge X-Forwarded-For and walk past every
# rate limit. This single line is what makes that impossible.
# ==========================================
# For Local Development (running on your Mac)
# ==========================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truelabel
DATABASE_URL=postgresql://neondb_owner:npg_6bjtF7mSizAT@ep-withered-rain-b3xnvqvk-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=truelabel

# REDIS_URL=redis://localhost:6379
REDIS_URL=rediss://default:gQAAAAAAAaI3AAIgcDJkZmJhMjdjMGVmNzE0MGUyODA5YjNiZTI5ZDAzNzNjNg@promoted-crappie-107063.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

RUST_LOG=info
RUST_BACKTRACE=0

APP_ENV=production
APPLE_BUNDLE_ID=com.tarun.truelable
TRUSTED_PROXY_HOPS=1
ALLOWED_ORIGINS=

MAX_DB_CONNECTIONS=10
MAX_REDIS_CONNECTIONS=10

# ==========================================
# For Kubernetes Deployment (inside cluster)
# ==========================================
# DATABASE_URL=postgresql://postgres:postgres@db-service:5432/postgres
# REDIS_URL=redis://redis-service:6379
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
