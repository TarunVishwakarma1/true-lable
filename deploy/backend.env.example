# /etc/truelabel/backend.env — chmod 0640, owned root:truelabel.

# Loopback, not 0.0.0.0. nginx is on the same host, so nothing else needs to
# reach this port — and with TRUSTED_PROXY_HOPS set, anyone who could reach
# it directly would be able to forge X-Forwarded-For and walk past every
# rate limit. This single line is what makes that impossible.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

APP_ENV=production
RUST_LOG=info

# nginx is the one proxy in front, and it appends the real client address to
# X-Forwarded-For. Without this the peer address is always nginx, so every
# user in the world shares one rate-limit bucket and the API starts returning
# 429 to everybody. Count only hops that append: add a CDN in front and this
# becomes 2.
TRUSTED_PROXY_HOPS=1

# Browser origins allowed to call the API. The iOS app sends no Origin, so
# this only needs whatever actually calls the API from a browser — today
# that's just the dashboard.
ALLOWED_ORIGINS=https://dashboard.truelabel.fun

# External managed services (Neon Postgres, Upstash Redis) — nothing to
# self-host or firewall to loopback on this box. `redis`'s Cargo features
# already include TLS, so Upstash's rediss:// just works. Migrating either
# later, including to something self-hosted on this same box, is these two
# values changing and nothing else.
DATABASE_URL=postgresql://CHANGE_ME.neon.tech/truelabel?sslmode=require
REDIS_URL=rediss://CHANGE_ME.upstash.io:6379
MAX_DB_CONNECTIONS=10
MAX_REDIS_CONNECTIONS=10

APPLE_BUNDLE_ID=com.tarun.truelable

# JWT audience for Google Sign-In ID-token verification (Android app) — the
# Web application OAuth client ID from Google Cloud Console, not the
# separate Android-type client (no secret, never sent here). Optional:
# leave unset and POST /api/v1/me/link/google refuses cleanly.
# GOOGLE_OAUTH_CLIENT_ID=

# Optional. A PAT with Issues:write on GITHUB_REPO (fine-grained) or the
# classic `repo` scope — powers the dashboard's "publish as GitHub issue"
# button only. Leave both unset and that one button fails with a clear
# error; everything else works without it.
# GITHUB_TOKEN=
# GITHUB_REPO=TarunVishwakarma1/true-lable

# Lets a filed GitHub issue link back to the crash report it came from.
# DASHBOARD_URL=https://dashboard.truelabel.fun

# The shared secret configured on the GitHub webhook (repo Settings ->
# Webhooks -> Add webhook, Payload URL https://api.truelabel.fun/api/v1/webhooks/github)
# — lets closing/reopening an issue directly on GitHub sync back onto the
# linked crash report's status. Generate with `openssl rand -hex 32` and set
# the same value on both sides. Optional: leave unset and that one endpoint
# refuses every delivery with a clear error; everything else works without it.
# GITHUB_WEBHOOK_SECRET=238f3470dc35d442ed32061772a9f65d8ea9e101db4cefcedc9407cea61495c7
#
# Optional: outgoing notification webhook URL for Slack / Discord / custom webhook channels.
# Triggers on new user registrations, access elevation requests, and role promotions.
# NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/...
