# Copy to backend.hcl (gitignored) after `terraform apply` in ../bootstrap,
# filling in that run's `state_bucket`/`lock_table` outputs. Then:
#   terraform init -backend-config=backend.hcl
bucket         = "true-label-tfstate"
key            = "cluster/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "true-label-tfstate-lock"
encrypt        = true
